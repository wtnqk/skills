{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-add-dir"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": 10000
  },
  "watcher": {
    "ignore": [
      ".devenv/**",
      ".direnv/**",
      ".terraform/**",
      "result/**",
      ".git/**",
      "node_modules/**",
      "flake.lock"
    ]
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "claude-code",
          "--enable-web-dashboard",
          "false"
        ]
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "ast-grep": {
        "type": "local",
        "command": [
          "ast-grep-server"
        ]
      }
    }
  },
  "permissions": [
    { "action": "bash", "resource": "*", "effect": "allow" },
    { "action": "bash", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "bash", "resource": "rm -rf /", "effect": "deny" },
    { "action": "bash", "resource": "sudo rm -rf *", "effect": "deny" },
    { "action": "bash", "resource": "dd if=*", "effect": "deny" },
    { "action": "bash", "resource": "mkfs.*", "effect": "deny" },
    { "action": "bash", "resource": "fdisk *", "effect": "deny" },
    { "action": "bash", "resource": "shutdown *", "effect": "deny" },
    { "action": "bash", "resource": "reboot *", "effect": "deny" },
    { "action": "bash", "resource": "halt *", "effect": "deny" },
    { "action": "bash", "resource": "poweroff *", "effect": "deny" },
    { "action": "bash", "resource": "killall *", "effect": "deny" },
    { "action": "bash", "resource": "pkill -f *", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "write", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "search", "resource": "*", "effect": "allow" },
    { "action": "ask", "resource": "*", "effect": "allow" },
    { "action": "memo", "resource": "*", "effect": "allow" },
    { "action": "http", "resource": "*", "effect": "allow" }
  ]
}
